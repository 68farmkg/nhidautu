---
import '../styles/global.css';
import '../styles/core.css';
import '../styles/chatpro.css';
import { icon } from '../lib/icons';
import { listEntries } from '../lib/px/registry';
import { can } from '../lib/perm';
import { first } from '../lib/util';
import { pluginOn } from '../lib/chatcfg';
const { title = 'Quản trị', active = '' } = Astro.props;
const U: any = (Astro.locals as any).user || { role: 'admin', name: '' };
let unread = 0, nMail = 0, nChat = 0;
const proOn = await pluginOn(Astro.locals.runtime.env.DB, 'chat-pro');
try { const r = await first(Astro.locals.runtime.env.DB, "SELECT (SELECT COUNT(*) FROM conversations WHERE unread_admin>0) c, (SELECT COUNT(*) FROM messages m LEFT JOIN inbox_state s ON s.msg_id=m.id WHERE COALESCE(s.status,'new')='new') m"); nChat = r?.c || 0; nMail = r?.m || 0; unread = nChat + nMail; } catch { /* chưa có bảng */ }
const badge = (k: string) => (proOn ? (k === 'msg' ? nMail : k === 'chat' ? nChat : 0) : k === 'msg' ? unread : 0);
type Item = [string, string, string, string];
const groups0: [string, Item[]][] = [
  ['Nội dung', [['/admin', 'Tổng quan', 'home', 'home'], ...(proOn ? [['/admin/hop-thu', 'Hộp thư', 'msg', 'mail'], ['/admin/chat', 'Chat khách', 'chat', 'message']] : [['/admin/hop-thu', 'Hộp thư & chat', 'msg', 'message']]) as Item[], ['/admin/trang', 'Trang', 'pages', 'file'], ['/admin/bai-viet', 'Bài viết', 'posts', 'news']]],
  ['Giao diện', [['/admin/menu', 'Menu & chân trang', 'menu', 'menu'], ['/admin/cai-dat', 'Cài đặt website', 'site', 'settings'], ...(proOn ? [['/admin/cai-dat#chat', 'Chat, AI & hộp thư gửi', 'chatset', 'bot']] : []) as Item[], ['/admin/tien-ich', 'Tiện ích & plugin', 'tools', 'puzzle']]],
  ['Công cụ', [['/admin/ai', 'AI Content Studio', 'ai', 'bot'], ['/admin/rss', 'Tin RSS các báo', 'rss', 'rss'], ['/admin/thi-truong', 'Số liệu thị trường', 'market', 'chart'], ['/admin/cai-dat-ai', 'Cài đặt AI (API)', 'aiset', 'shield']]],
  ['Hệ thống', [['/admin/nguoi-dung', 'Người dùng & quyền', 'users', 'user'], ['/admin/tai-khoan', 'Tài khoản của tôi', 'acct', 'settings']]],
];
let ents: Awaited<ReturnType<typeof listEntries>> = [];
try { ents = await listEntries(Astro.locals.runtime.env.DB); } catch { /* bỏ */ }
const plug = ents.filter((e) => e.active && (e.builtin?.admin || (e.manifest?.adminPages.length ?? 0) > 0)).map((e) => [`/admin/p/${e.id}`, e.name, 'p:' + e.id, e.icon || 'puzzle'] as Item);
if (plug.length) groups0.push(['Plugin', plug]);
const groups = groups0.map(([g, items]) => [g, items.filter((i) => can(U.role, i[0]))] as [string, Item[]]).filter(([, items]) => items.length);
const bar = ([['/admin', 'Tổng quan', 'home', 'home'], ['/admin/hop-thu', 'Hộp thư', 'msg', proOn ? 'mail' : 'message'], ...(proOn ? [['/admin/chat', 'Chat', 'chat', 'message']] : []) as Item[], ['/admin/trang', 'Trang', 'pages', 'file'], ['/admin/bai-viet', 'Bài viết', 'posts', 'news']] as Item[]).filter((i) => can(U.role, i[0]));
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>{title} | Quản trị Nhịp</title>
  <link rel="icon" href="/favicon.svg" />
</head>
<body>
  <div class="atop"><button type="button" data-dr aria-label="Menu" set:html={icon('menu', 26)}></button><b>{title}</b><a href="/" target="_blank" aria-label="Xem website" style="color:#fff" set:html={icon('eye', 22)}></a></div>
  <div class="drawer-bg" data-dr></div>
  <aside class="drawer" id="admdr">
    <div class="drawer-head"><b>Nhịp admin</b><button type="button" data-dr set:html={icon('x', 24)}></button></div>
    {groups.map(([g, items]) => (<><div class="grp" style="font-size:11px;text-transform:uppercase;color:#7fa39e;margin:12px 12px 4px">{g}</div>
      {items.map(([h, l, k, ic]) => <a href={h} class={active === k ? 'on' : ''}><Fragment set:html={icon(ic)} />{l}{badge(k) > 0 && <span class="bdg">{badge(k)}</span>}</a>)}</>))}
    <a href="/" target="_blank"><Fragment set:html={icon('eye')} />Xem website</a><a href="/admin/logout"><Fragment set:html={icon('x')} />Đăng xuất</a>
  </aside>
  <div class="adm">
    <aside class="side">
      <a class="logo" href="/admin"><i>↗</i><span>Nhịp admin</span></a>
      {groups.map(([g, items]) => (<><div class="grp">{g}</div>
        {items.map(([h, l, k, ic]) => <a href={h} class={active === k ? 'on' : ''}><Fragment set:html={icon(ic, 18)} />{l}{badge(k) > 0 && <span class="bdg">{badge(k)}</span>}</a>)}</>))}
      <div class="grp">{U.name || 'Chủ website'} · {U.role}</div>
      <a href="/" target="_blank"><Fragment set:html={icon('eye', 18)} />Xem website</a>
      <a href="/admin/logout"><Fragment set:html={icon('x', 18)} />Đăng xuất</a>
    </aside>
    <main class="main"><slot /></main>
  </div>
  <nav class="abar">
    {bar.map(([h, l, k, ic]) => <a href={h} class={active === k ? 'on' : ''}><Fragment set:html={icon(ic, 22)} /><span>{l}</span>{badge(k) > 0 && <span class="bdg">{badge(k)}</span>}</a>)}
    <button type="button" data-dr><Fragment set:html={icon('grid', 22)} /><span>Thêm</span></button>
  </nav>
  <script is:inline>
    document.querySelectorAll('[data-dr]').forEach(function (el) { el.addEventListener('click', function (e) { e.preventDefault(); document.body.classList.toggle('dr-open'); }); });
  </script>
</body>
</html>
