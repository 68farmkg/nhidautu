---
import { fmtDay } from '../lib/util';
import { getCats } from '../lib/terms';
// v: row (ảnh nhỏ bên trái) | card (ảnh trên) | feat (ảnh lớn + tóm tắt). `big` giữ để tương thích mã cũ.
const { p, big = false, v = big ? 'feat' : 'row' } = Astro.props;
const CATS = await getCats(Astro.locals.runtime.env.DB);
---
<a class={`pc2 ${v}`} href={`/bai-viet/${p.slug}`}>
  <div class="im">{p.image ? <img src={p.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <i class="im-ph" aria-hidden="true"></i>}</div>
  <div class="tx">
    <span class="ct">{CATS[p.category] || p.category}</span>
    <h3>{p.title}</h3>
    {(v === 'feat' || v === 'card') && p.summary && <p>{p.summary}</p>}
    <div class="meta">{fmtDay(p.published_at)}</div>
  </div>
</a>
