---
import PostCard from './PostCard.astro';
import { getPosts } from '../lib/ui';
import { all, nowIso } from '../lib/util';
const { cat = '', q = '', page = 1 } = Astro.props;
const db = Astro.locals.runtime.env.DB;
const per = 12;
let posts: any[] = [], more = false;
if (q) {
  const l = `%${q}%`;
  const rows = await all(db, `SELECT id,slug,title,summary,image,category,published_at FROM posts WHERE status='published' AND published_at <= ? AND (title LIKE ? OR summary LIKE ? OR tickers LIKE ?)${cat ? ' AND category = ?' : ''} ORDER BY published_at DESC LIMIT ${per + 1} OFFSET ${(page - 1) * per}`, ...[nowIso(), l, l, l, ...(cat ? [cat] : [])]);
  posts = rows.slice(0, per); more = rows.length > per;
} else { ({ rows: posts, more } = await getPosts(db, { cat, limit: per, offset: (page - 1) * per })); }
const base = Astro.url.pathname;
const qs = (n: number) => `${base}?${q ? 'q=' + encodeURIComponent(q) + '&' : ''}trang=${n}`;
---
<div class="box">
  {posts.length === 0 && <p class="empty">Chưa có bài viết phù hợp.</p>}
  <div class="pgrid g3">{posts.map((p) => <PostCard p={p} v="card" />)}</div>
  {(page > 1 || more) && (
    <div class="pager">
      <span>{page > 1 && <a class="btn ghost" href={qs(page - 1)}>← Trang trước</a>}</span>
      <span>{more && <a class="btn ghost" href={qs(page + 1)}>Trang sau →</a>}</span>
    </div>
  )}
</div>
