---
import { getFeed } from '../lib/rss';
import { fmtDay } from '../lib/util';
const { title = 'Tin từ các báo', limit = 6 } = Astro.props;
const keys = ['cafef-ck', 'vietstock-ck', 'vneconomy-ck'];
const res = await Promise.allSettled(keys.map((k) => getFeed(k, 6, 4000)));
const seen = new Set<string>();
const items = res.flatMap((r) => (r.status === 'fulfilled' ? r.value : []))
  .filter((i) => (seen.has(i.link) ? false : seen.add(i.link)))
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, limit);
---
{items.length > 0 && (
  <section class="box">
    <div class="sh"><h2>{title}</h2></div>
    <ul class="tl">
      {items.map((i) => (
        <li><a href={i.link} target="_blank" rel="noopener nofollow"><b>{i.title}</b></a>
          <span class="meta">{i.source.split(' · ')[0]}{i.date && !isNaN(+new Date(i.date)) ? ' · ' + fmtDay(new Date(i.date).toISOString()) : ''}</span></li>
      ))}
    </ul>
  </section>
)}
