---
import Slot from '../../components/Slot.astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import PageHero from '../../components/PageHero.astro';
import SH from '../../components/SH.astro';
import { all, first, nowIso, fmtNum, fmtPct, fmtDate } from '../../lib/util';
import { klChart } from '../../lib/kline';
import { dsym } from '../../lib/market';
const db = Astro.locals.runtime.env.DB;
const sym = (Astro.params.symbol || '').toUpperCase();
const q = await first(db, 'SELECT * FROM quotes WHERE symbol=?', sym);
if (!q) return new Response('Không tìm thấy mã', { status: 404 });
const news = await all(db, "SELECT id,slug,title,summary,image,category,published_at FROM posts WHERE status='published' AND published_at <= ? AND (',' || REPLACE(UPPER(tickers),' ','') || ',') LIKE ? ORDER BY published_at DESC LIMIT 8", nowIso(), `%,${sym},%`);
const chartHtml = klChart(dsym(sym), 'D', 460);
---
<Base title={`${sym} - ${q.name}`} active="thi-truong">
  <PageHero crumb={sym} title={`${sym} · ${q.name}`} sub={[q.exchange, q.sector].filter(Boolean).join(' · ')} />
  <div class="wrap">
    <section class="box" style="margin-top:-40px;position:relative;z-index:2;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap">
      <b style="font-size:32px;letter-spacing:-.01em">{fmtNum(q.price)}</b>
      <span class={`chg ${q.change_pct >= 0 ? 'up' : 'down'}`} style="font-size:17px">{q.change_pct >= 0 ? '▲' : '▼'} {fmtPct(q.change_pct)}</span>
      <span class="meta">Cập nhật {fmtDate(q.updated_at)}</span>
    </section>
    <div class="cols">
      <section class="box"><SH title="Biểu đồ giá" />
        <Fragment set:html={chartHtml} />
      </section>
      <section class="box"><SH title="Tin liên quan" />
        {news.length === 0 && <p class="empty">Chưa có tin về mã này.</p>}
        <div class="plist">{news.map((p) => <PostCard p={p} />)}</div>
      </section>
    </div>
  </div>
<Slot name="stock.bottom" />
</Base>
