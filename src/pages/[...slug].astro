---
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import { first } from '../lib/util';
import { parseBlocks } from '../lib/blocks';
import { pbCfg } from '../lib/pb/cfg';
import { renderPage } from '../lib/pb/render';
import { getSite } from '../lib/site';
const db = Astro.locals.runtime.env.DB;
const slug = (Astro.params.slug || '').replace(/\/+$/, '');
let page: any = null;
try { page = await first(db, "SELECT * FROM pages WHERE slug=? AND status='published' AND is_template=0", slug); } catch { /* chưa chạy nang-cap-2.sql */ }
if (!page) return new Response('Không tìm thấy trang', { status: 404 });
// Page Builder Pro (chỉ khi plugin đang bật): bố cục, meta, schema; trang cũ không có meta vẫn hiển thị như trước
const cfg = await pbCfg(db);
let pro: any = null;
if (cfg.on) {
  try {
    const metaRow = await first(db, 'SELECT meta,side FROM px_page_builder_meta WHERE page_id=?', page.id).catch(() => null);
    pro = await renderPage(db, page, metaRow, Astro.url, { site: (await getSite(db)).name });
    if (cfg.cache) Astro.response.headers.set('Cache-Control', `public, max-age=0, s-maxage=${cfg.cache}, stale-while-revalidate=${cfg.cache * 4}`);
  } catch { pro = null; }
}
---
{pro ? (
  <Base title={page.seo_title || page.title} description={page.seo_desc} image={page.seo_image} hideHeader={!page.show_header} hideFooter={!page.show_footer} headHtml={pro.head} canonical={pro.meta.canonical || Astro.url.origin + '/' + page.slug} noindex={pro.meta.noindex} jsonld={pro.jsonld}>
    <Fragment set:html={pro.html} />
  </Base>
) : (
  <Base title={page.seo_title || page.title} description={page.seo_desc} image={page.seo_image} hideHeader={!page.show_header} hideFooter={!page.show_footer}>
    <Blocks blocks={parseBlocks(page.blocks)} />
  </Base>
)}
