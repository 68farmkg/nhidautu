---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import PageHero from '../../components/PageHero.astro';
import CatDoanhNghiep from '../../components/cat/CatDoanhNghiep.astro';
import CatPhanTich from '../../components/cat/CatPhanTich.astro';
import CatKienThuc from '../../components/cat/CatKienThuc.astro';
import { getCats } from '../../lib/terms';
const CATS = await getCats(Astro.locals.runtime.env.DB);
const { cat } = Astro.params;
if (!cat || !CATS[cat]) return Astro.redirect('/tin-tuc');
const page = Math.max(1, Number(Astro.url.searchParams.get('trang')) || 1);
---
<Base title={CATS[cat]} active={cat}>
  {cat === 'doanh-nghiep' ? <CatDoanhNghiep page={page} />
    : cat === 'phan-tich' ? <CatPhanTich page={page} />
    : cat === 'kien-thuc' ? <CatKienThuc page={page} />
    : <>
        <PageHero crumb={CATS[cat]} title={CATS[cat]} />
        <div class="wrap" style="margin-top:20px"><PostList cat={cat} page={page} /></div>
      </>}
</Base>
