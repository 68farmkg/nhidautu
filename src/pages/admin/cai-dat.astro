---
import Admin from '../../layouts/Admin.astro';
import { all, run } from '../../lib/util';
import { getSite, SITE_KEYS, DEF } from '../../lib/site';
const db = Astro.locals.runtime.env.DB;
let msg = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  for (const k of SITE_KEYS) {
    if (!f.has(k)) continue; const v = String(f.getAll(k).pop() || '').slice(0, 20000);
    await run(db, 'INSERT INTO kv (k,v) VALUES (?,?) ON CONFLICT(k) DO UPDATE SET v=excluded.v', 's.' + k, v);
  }
  return Astro.redirect('/admin/cai-dat?saved=1');
}
const S: any = await getSite(db);
let pages: any[] = []; try { pages = await all(db, "SELECT slug,title FROM pages WHERE status='published' AND is_template=0"); } catch { /* */ }
const T = (k: string, l: string, ph = '') => ({ k, l, ph });
const rows = [
  { h: 'Thông tin chung', f: [T('name', 'Tên website'), T('tagline', 'Khẩu hiệu'), T('logo', 'Link logo (https://…, để trống dùng biểu tượng mặc định)'), T('email', 'Email'), T('hotline', 'Hotline'), T('address', 'Địa chỉ')] },
  { h: 'Màu sắc', f: [T('color', 'Màu chủ đạo (nút, điểm nhấn)', '#12b76a'), T('color_dark', 'Màu nền thanh menu và chân trang', '#0a2a2f')] },
  { h: 'Chân trang', f: [T('f1_title', 'Tiêu đề cột 1'), T('f2_title', 'Tiêu đề cột 2'), T('disclaimer', 'Dòng bản quyền / miễn trừ'), T('social_fb', 'Link Facebook'), T('social_yt', 'Link YouTube'), T('social_zalo', 'Link Zalo')] },
];
---
<Admin title="Cài đặt website" active="site">
  <div class="pagehead"><h1>Cài đặt website</h1></div>
  {Astro.url.searchParams.get('saved') && <div class="msg">Đã lưu. Tải lại trang web để thấy thay đổi.</div>}
  <form method="post">
    {rows.map((g) => (
      <div class="box" style="margin-bottom:12px"><h3>{g.h}</h3>
        {g.f.map((x) => <><label for={x.k}>{x.l}</label><input id={x.k} type="text" name={x.k} value={S[x.k] || ''} placeholder={x.ph || String((DEF as any)[x.k] || '')} /></>)}
        {g.h === 'Chân trang' && <><label for="footer_text">Giới thiệu ngắn ở chân trang</label><textarea id="footer_text" name="footer_text" style="min-height:70px">{S.footer_text}</textarea></>}
      </div>
    ))}
    <div class="box" style="margin-bottom:12px"><h3>Trang chủ</h3>
      <label for="home_page">Dùng một trang tự dựng làm trang chủ</label>
      <select id="home_page" name="home_page"><option value="">Giao diện trang chủ mặc định</option>{pages.map((p) => <option value={p.slug} selected={S.home_page === p.slug}>{p.title} (/{p.slug})</option>)}</select></div>
    <div class="box" style="margin-bottom:12px"><h3>Chat khách hàng</h3>
      <p class="meta">Bật để hiện nút chat góc phải màn hình. Tin nhắn nằm ở Admin &gt; Hộp thư & chat. Muốn nhận báo ngay trên điện thoại: thêm biến TELEGRAM_BOT_TOKEN và TELEGRAM_CHAT_ID trong Cloudflare (xem HUONG-DAN.md).</p>
      <input type="hidden" name="chat_on" value="" />
      <label class="chk"><input type="checkbox" name="chat_on" value="1" checked={S.chat_on === '1'} />Bật chat trên website</label>
      <label for="chat_title">Tiêu đề cửa sổ chat</label><input id="chat_title" type="text" name="chat_title" value={S.chat_title} />
      <label for="chat_welcome">Lời chào đầu tiên</label><textarea id="chat_welcome" name="chat_welcome" style="min-height:70px">{S.chat_welcome}</textarea></div>
    <div class="box"><h3>Mã nâng cao</h3><p class="meta">Dán mã Google Analytics, Facebook Pixel, chat… Chỉ dán mã bạn tin tưởng.</p>
      <label for="head_code">Mã chèn vào &lt;head&gt;</label><textarea id="head_code" name="head_code" style="font-family:monospace">{S.head_code}</textarea>
      <label for="body_code">Mã chèn cuối trang</label><textarea id="body_code" name="body_code" style="font-family:monospace">{S.body_code}</textarea></div>
    <div class="savebar"><button class="btn" type="submit">Lưu cài đặt</button></div>
  </form>
</Admin>
