---
import Admin from '../../layouts/Admin.astro';
import { all, first, run, nowIso, fmtDate } from '../../lib/util';
import { hashPw } from '../../lib/auth';
import { listRoles } from '../../lib/roles';
import { CAPS } from '../../lib/perm';
import { ensureActivity, ACTIONS } from '../../lib/activity';
import '../../styles/admin-pro.css';
const db = Astro.locals.runtime.env.DB;
const log = (a: string, o = '', s = '') => (Astro.locals as any).log?.(a, o, s);
const RR = await listRoles(db);
const ROLES: Record<string, string> = Object.fromEntries(RR.map((r) => [r.slug, r.name]));
let err = '', ok = '', addErr = false;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData(); const act = String(f.get('act')); const id = Number(f.get('id')) || 0;
  const role = Object.keys(ROLES).includes(String(f.get('role'))) ? String(f.get('role')) : 'editor';
  try {
    if (act === 'add') {
      const un = String(f.get('username') || '').trim().toLowerCase(), pw = String(f.get('password') || '');
      if (!/^[a-z0-9._-]{3,30}$/.test(un)) { addErr = true; err = 'Tên đăng nhập 3-30 ký tự: chữ thường không dấu, số, dấu . _ -'; }
      else if (pw.length < 8) { addErr = true; err = 'Mật khẩu tối thiểu 8 ký tự.'; }
      else if (await first(db, 'SELECT id FROM users WHERE username=?', un)) { addErr = true; err = 'Tên đăng nhập đã có người dùng.'; }
      else { await run(db, 'INSERT INTO users (username,name,pass,role,active,created_at) VALUES (?,?,?,?,1,?)', un, String(f.get('name') || '').trim().slice(0, 60) || un, await hashPw(pw), role, nowIso()); await log('user.add', 'user:' + un, `Vai trò ${role}`); ok = `Đã tạo tài khoản ${un}.`; }
    }
    if (act === 'role' && id) { await run(db, 'UPDATE users SET role=?,name=? WHERE id=?', role, String(f.get('name') || '').trim().slice(0, 60), id); await log('user.role', 'user:' + id, `Vai trò ${role}`); ok = 'Đã cập nhật.'; }
    if (act === 'toggle' && id) { await run(db, 'UPDATE users SET active=1-active WHERE id=?', id); await log('user.toggle', 'user:' + id); ok = 'Đã đổi trạng thái.'; }
    if (act === 'pw' && id) {
      const pw = String(f.get('password') || '');
      if (pw.length < 8) err = 'Mật khẩu mới tối thiểu 8 ký tự.'; else { await run(db, 'UPDATE users SET pass=? WHERE id=?', await hashPw(pw), id); await log('user.pw', 'user:' + id); ok = 'Đã đặt lại mật khẩu.'; }
    }
    if (act === 'delete' && id) { await run(db, 'DELETE FROM users WHERE id=?', id); await log('user.delete', 'user:' + id); ok = 'Đã xóa.'; }
  } catch (e: any) { err = 'Lỗi: ' + (e?.message || e) + '. Bạn đã chạy nang-cap-3.sql chưa?'; }
}
let rows: any[] = [];
try { rows = await all(db, 'SELECT id,username,name,role,active,last_login,created_at FROM users ORDER BY id'); } catch { err = err || 'Chưa có bảng người dùng. Hãy chạy nang-cap-3.sql trong D1 Console.'; }

const sp = Astro.url.searchParams;
const q = (sp.get('q') || '').trim().slice(0, 60).toLowerCase();
const fr = sp.get('role') && ROLES[sp.get('role')!] ? sp.get('role')! : '';
const fs = ['on', 'off'].includes(sp.get('st') || '') ? sp.get('st')! : '';
const per = 10, page = Math.max(1, Number(sp.get('trang')) || 1);
const list = rows.filter((u) => (!q || `${u.username} ${u.name}`.toLowerCase().includes(q)) && (!fr || u.role === fr) && (!fs || (fs === 'on' ? u.active : !u.active)));
const pages = Math.max(1, Math.ceil(list.length / per)), cur = Math.min(page, pages);
const view = list.slice((cur - 1) * per, cur * per);
const uid = Number(sp.get('u')) || 0;
const sel = rows.find((u) => u.id === uid) || view[0] || null;
const qs = (o: Record<string, string | number>) => {
  const m: Record<string, string> = { q, role: fr, st: fs, u: '', trang: '' }; for (const [k, v] of Object.entries(o)) m[k] = String(v);
  const s = Object.entries(m).filter(([, v]) => v !== '' && v !== '0').map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&'); return '/admin/nguoi-dung' + (s ? '?' + s : '');
};
const nOn = rows.filter((u) => u.active).length, nOff = rows.length - nOn;
const byRole = Object.keys(ROLES).map((k) => ({ k, n: rows.filter((u) => u.role === k).length }));
const roleCards = [...byRole].sort((a, b) => b.n - a.n).slice(0, 3);
const pct = (x: number) => (rows.length ? Math.round((x / rows.length) * 1000) / 10 : 0);
const ini = (u: any) => String(u.name || u.username || '?').trim().split(/\s+/).slice(-2).map((w: string) => w[0]).join('').toUpperCase();
const recent7 = rows.filter((u) => u.created_at && Date.now() - Date.parse(u.created_at) < 7 * 864e5).length;
const rolePill: Record<string, string> = { admin: 'g', editor: 'b', support: 'o' };
let caps: string[] = [], acts: any[] = [];
if (sel) {
  const rr = RR.find((r) => r.slug === sel.role);
  caps = sel.role === 'admin' ? ['Toàn quyền quản trị'] : (rr?.caps || []).map((c) => CAPS[c]?.label || c);
  try { await ensureActivity(db); acts = await all(db, 'SELECT at,action,summary FROM activity_log WHERE uid=? ORDER BY id DESC LIMIT 5', sel.id); } catch { /* bỏ */ }
}
const nf = (x: number) => x.toLocaleString('vi-VN');
---
<Admin title="Người dùng & quyền" active="users">
<div class="ap">
  <div class="ap-head"><div><h1>Quản lý tài khoản</h1><p>Quản lý người dùng, vai trò và quyền truy cập hệ thống.</p></div>
    <p style="display:flex;gap:8px;flex-wrap:wrap;margin:0"><a class="ap-btn ghost" href="/admin/nguoi-dung/vai-tro">Vai trò & quyền</a><a class="ap-btn ghost" href="/admin/nhat-ky?nhom=login">Lịch sử đăng nhập</a><a class="ap-btn" href="#them">+ Thêm tài khoản</a></p></div>
  {err && <div class="ap-msg err">{err}</div>}{ok && <div class="ap-msg">{ok}</div>}

  <div class="ap-stats">
    <div class="ap-stat"><i>👤</i><div><small>Tổng tài khoản</small><b>{nf(rows.length)}</b><em>+{recent7} trong 7 ngày</em></div></div>
    <div class="ap-stat b"><i>✓</i><div><small>Đang hoạt động</small><b>{nf(nOn)}</b><em>{pct(nOn)}% tổng số</em></div></div>
    {roleCards.map((c, i) => <div class={`ap-stat ${['p', 'o', 'x'][i]}`}><i>{ROLES[c.k].slice(0, 1).toUpperCase()}</i><div><small>{ROLES[c.k]}</small><b>{nf(c.n)}</b><em>{pct(c.n)}% tổng số</em></div></div>)}
  </div>

  <div class="ap-grid">
    <div>
      <div class="ap-card">
        <form method="get" class="ap-filter">
          <input class="q" type="search" name="q" value={q} placeholder="Tìm theo tên, tên đăng nhập…" maxlength="60" aria-label="Tìm người dùng" />
          <select name="role" aria-label="Vai trò"><option value="">Tất cả vai trò</option>{Object.entries(ROLES).map(([k, v]) => <option value={k} selected={fr === k}>{v}</option>)}</select>
          <select name="st" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="on" selected={fs === 'on'}>Đang hoạt động ({nOn})</option><option value="off" selected={fs === 'off'}>Đã khóa ({nOff})</option></select>
          <button class="ap-btn" type="submit">Lọc</button><a class="ap-btn ghost" href="/admin/nguoi-dung">Đặt lại</a>
        </form>
        <div class="ap-scroll"><table class="ap-table rs">
          <thead><tr><th>Người dùng</th><th>Vai trò</th><th>Trạng thái</th><th>Đăng nhập cuối</th><th></th></tr></thead>
          <tbody>
            {view.length === 0 && <tr><td colspan="5"><div class="ap-empty">{rows.length === 0 ? 'Chưa có người dùng nào ngoài chủ website.' : 'Không có tài khoản khớp bộ lọc.'}</div></td></tr>}
            {view.map((u) => (
              <tr class={sel && sel.id === u.id ? 'sel' : ''}>
                <td><a href={qs({ u: u.id })} class="ap-user" style="text-decoration:none;color:inherit"><span class="ap-av">{ini(u)}</span><span><b>{u.name || u.username}</b><small>{u.username}</small></span></a></td>
                <td data-l="Vai trò"><span class={`ap-pill ${rolePill[u.role] || ''}`}>{ROLES[u.role] || u.role}</span></td>
                <td data-l="Trạng thái"><span class={`ap-pill ${u.active ? 'g' : 'r'}`}>{u.active ? 'Hoạt động' : 'Đã khóa'}</span></td>
                <td data-l="Đăng nhập cuối">{u.last_login ? fmtDate(u.last_login) : 'Chưa đăng nhập'}</td>
                <td><a class="ap-btn ghost sm" href={qs({ u: u.id })}>Chi tiết</a></td>
              </tr>
            ))}
          </tbody>
        </table></div>
        <div class="ap-pager"><span>{list.length === 0 ? 'Không có kết quả' : `Hiển thị ${(cur - 1) * per + 1}–${Math.min(cur * per, list.length)} trong ${list.length} kết quả`}</span>
          <nav aria-label="Phân trang"><a class={cur <= 1 ? 'dis' : ''} href={qs({ trang: cur - 1 })}>‹</a>{Array.from({ length: pages }, (_, i) => i + 1).map((p) => <a class={p === cur ? 'on' : ''} href={qs({ trang: p })}>{p}</a>)}<a class={cur >= pages ? 'dis' : ''} href={qs({ trang: cur + 1 })}>›</a></nav></div>
      </div>

      <div class="ap-card" id="them"><details class="ap-fold" open={addErr}><summary>+ Thêm tài khoản mới</summary>
        <form method="post"><input type="hidden" name="act" value="add" />
          <div><label for="nu">Tên đăng nhập (chữ thường không dấu)</label><input id="nu" type="text" name="username" required autocapitalize="none" /></div>
          <div><label for="nn">Tên hiển thị</label><input id="nn" type="text" name="name" /></div>
          <div><label for="nr">Vai trò</label><select id="nr" name="role">{Object.entries(ROLES).map(([k, v]) => <option value={k}>{v}</option>)}</select></div>
          <div><label for="np">Mật khẩu (tối thiểu 8 ký tự)</label><input id="np" type="password" name="password" required autocomplete="new-password" /></div>
          <button class="ap-btn" type="submit">Tạo tài khoản</button></form></details>
        <p style="font-size:12px;color:#6b7f7a;margin:8px 0 0">Chủ website đăng nhập bằng mật khẩu ADMIN_PASSWORD (để trống tên đăng nhập), luôn có toàn quyền và không nằm trong danh sách này. Biên tập viên không được thêm hoặc sửa khối “Mã HTML tự do” và “Tiện ích đã tạo”.</p></div>
    </div>

    <aside class="ap-side">
      {sel ? (<>
        <div class="ap-card"><h3>Thông tin tài khoản</h3>
          <div class="ap-prof"><span class="ap-av">{ini(sel)}</span><div><b>{sel.name || sel.username}</b><br /><span class={`ap-pill ${sel.active ? 'g' : 'r'}`}>{sel.active ? 'Hoạt động' : 'Đã khóa'}</span></div></div>
          <dl class="ap-kv"><dt>Tên đăng nhập</dt><dd>{sel.username}</dd><dt>Vai trò</dt><dd><span class={`ap-pill ${rolePill[sel.role] || ''}`}>{ROLES[sel.role] || sel.role}</span></dd><dt>Ngày tạo</dt><dd>{sel.created_at ? fmtDate(sel.created_at) : '—'}</dd><dt>Đăng nhập cuối</dt><dd>{sel.last_login ? fmtDate(sel.last_login) : 'Chưa đăng nhập'}</dd></dl>
          <details class="ap-fold"><summary>Chỉnh sửa thông tin</summary>
            <form method="post"><input type="hidden" name="act" value="role" /><input type="hidden" name="id" value={sel.id} />
              <div><label>Tên hiển thị</label><input type="text" name="name" value={sel.name} maxlength="60" /></div>
              <div><label>Vai trò</label><select name="role">{Object.entries(ROLES).map(([k, v]) => <option value={k} selected={sel.role === k}>{v}</option>)}</select></div>
              <button class="ap-btn" type="submit">Lưu</button></form></details>
          <details class="ap-fold"><summary>Đặt lại mật khẩu</summary>
            <form method="post"><input type="hidden" name="act" value="pw" /><input type="hidden" name="id" value={sel.id} /><input type="password" name="password" placeholder="Mật khẩu mới (≥ 8 ký tự)" autocomplete="new-password" /><button class="ap-btn ghost" type="submit">Đặt lại</button></form></details>
        </div>
        <div class="ap-card"><h3>Quyền hạn</h3>{caps.length ? <ul class="ap-list">{caps.map((c) => <li>{c}</li>)}</ul> : <p class="ap-empty" style="padding:6px">Vai trò này chưa được gán quyền nào.</p>}
          <p style="margin:10px 0 0"><a href="/admin/nguoi-dung/vai-tro" style="font-size:13px">Xem chi tiết vai trò →</a></p></div>
        <div class="ap-card"><h3>Hoạt động gần đây</h3>{acts.length ? <ul class="ap-log">{acts.map((a) => <li>{ACTIONS[a.action] || a.action}<small>{fmtDate(a.at)}{a.summary ? ' · ' + a.summary : ''}</small></li>)}</ul> : <p class="ap-empty" style="padding:6px">Chưa có hoạt động nào được ghi.</p>}
          <p style="margin:10px 0 0"><a href="/admin/nhat-ky" style="font-size:13px">Xem tất cả →</a></p></div>
        <div class="ap-card" style="display:grid;gap:8px">
          <form method="post"><input type="hidden" name="act" value="toggle" /><input type="hidden" name="id" value={sel.id} /><button class={`ap-btn ${sel.active ? 'red' : ''}`} type="submit" style="width:100%;justify-content:center">{sel.active ? 'Khóa tài khoản' : 'Mở khóa tài khoản'}</button></form>
          <form method="post" onsubmit="return confirm('Xóa người dùng này? Không khôi phục được.')"><input type="hidden" name="act" value="delete" /><input type="hidden" name="id" value={sel.id} /><button class="ap-btn red" type="submit" style="width:100%;justify-content:center">Xóa tài khoản</button></form>
        </div>
      </>) : <div class="ap-card"><p class="ap-empty">Chọn một tài khoản để xem chi tiết.</p></div>}
    </aside>
  </div>
</div>
</Admin>
