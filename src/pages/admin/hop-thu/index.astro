---
import { pluginOn } from '../../../lib/chatcfg';
import MailPro from '../../../components/MailPro.astro';
import MailBasic from '../../../components/MailBasic.astro';
// Đã cài plugin "Hộp thư & Chat Pro" thì dùng Hộp thư Pro; chưa cài thì giữ Hộp thư & chat cơ bản như cũ.
const proOn = await pluginOn(Astro.locals.runtime.env.DB, 'chat-pro');
---
{proOn ? <MailPro /> : <MailBasic />}
