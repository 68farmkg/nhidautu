---
import Admin from '../../layouts/Admin.astro';
import { CATS } from '../../lib/util';
import { CATALOG, loadSettings, keyOf } from '../../lib/ai';
import { generateDraft } from '../../lib/draft';
const env = Astro.locals.runtime.env;
const db = env.DB;
const st = await loadSettings(db);
const ready = CATALOG.filter((p) => st[p.id]?.enabled && keyOf(env, p.id, st[p.id]));
let err = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const topic = String(f.get('topic') || '').trim().slice(0, 300);
  if (!topic) err = 'Hãy nhập chủ đề.';
  else {
    try {
      const r = await generateDraft(env, db, { topic, cat: String(f.get('category') || 'thi-truong'), note: String(f.get('note') || '').trim().slice(0, 3000), provider: String(f.get('provider') || 'auto') });
      return Astro.redirect(`/admin/bai-viet/${r.id}?ai=${encodeURIComponent(r.via)}`);
    } catch (e: any) {
      err = 'Không viết được: ' + (e?.message || e);
    }
  }
}
---
<Admin title="AI Content Studio" active="ai">
  <h1>AI Content Studio</h1>
  <p class="meta">Nhập chủ đề, AI viết bản nháp và đưa vào mục “Chờ duyệt”, kèm gợi ý ảnh để bạn tìm ảnh ở trang khác rồi dán link vào. Hãy đọc và kiểm tra số liệu trước khi đăng.</p>
  {ready.length === 0 && <div class="msg err">Chưa có nhà AI nào được bật. <a href="/admin/cai-dat-ai"><b>Vào Cài đặt AI để dán API key</b></a>.</div>}
  {err && <div class="msg err">{err}</div>}
  <form method="post" class="box">
    <label for="topic">Chủ đề</label><input id="topic" type="text" name="topic" placeholder="Phân tích diễn biến VN-Index tuần tới" required />
    <div class="row2">
      <div><label for="category">Chuyên mục</label>
        <select id="category" name="category">{Object.entries(CATS).map(([k, n]) => <option value={k}>{n}</option>)}</select></div>
      <div><label for="provider">Dùng AI</label>
        <select id="provider" name="provider"><option value="auto">Tự động (thử lần lượt)</option>{ready.map((p) => <option value={p.id}>{p.name}</option>)}</select></div>
    </div>
    <label for="note">Thông tin/nguồn bạn muốn AI dùng (không bắt buộc)</label>
    <textarea id="note" name="note" placeholder="Dán số liệu, tin tức hoặc ý chính vào đây để bài chính xác hơn"></textarea>
    <p><button class="btn" type="submit">Viết bản nháp bằng AI</button></p>
    <p class="meta">AI mất khoảng 10–45 giây. Đừng đóng trang khi đang chạy.</p>
  </form>
</Admin>
